# ==============================================================
# Campus Lost & Found - Backend Environment Variables
# ==============================================================

# Server Configuration
# Render automatically sets PORT (defaults to 10000 or custom)
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# - Local dev: mongodb://127.0.0.1:27017/campus_lost_and_found (or leave blank for embedded memory DB)
# - Render production: MongoDB Atlas connection URI:
#   mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_lost_and_found?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_and_found

# JWT Secret Key for Authentication (Set a 32+ character random string in production)
JWT_SECRET=campus_lost_and_found_super_secret_jwt_key_2026
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes

# Frontend Client URL (for CORS allowance)
# - Local dev: http://localhost:5173
# - Production on Render: Set to your Vercel deployment URL (e.g. https://campus-lost-and-found.vercel.app)
CLIENT_URL=http://localhost:5173
